# Glimpse3D backend environment configuration
# Copy to .env and adjust. All values are optional; defaults are shown.

# --- Job persistence ----------------------------------------------------------
# Which backend the job repository uses: "sqlite" (default) or "supabase".
PERSISTENCE_BACKEND=sqlite

# SQLAlchemy database URL (used when PERSISTENCE_BACKEND=sqlite).
DATABASE_URL=sqlite:///./glimpse3d.db

# --- Supabase (only when PERSISTENCE_BACKEND=supabase) -------------------------
# Project REST URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# SERVER-SIDE writes use the service-role key. Keep it secret; never ship it
# to the browser. The backend repository uses this key for all reads/writes.
SUPABASE_SERVICE_ROLE_KEY=
# The anon key is CLIENT-READ ONLY (safe to expose to the frontend, subject to
# Row Level Security). The server does NOT use it for writes.
SUPABASE_ANON_KEY=

# --- Pipeline behavior --------------------------------------------------------
# Skip heavy model inference and return canned outputs (1/true/yes to enable).
GLIMPSE3D_DEMO_MODE=

# Overall pipeline wall-clock budget, in seconds.
PIPELINE_TIMEOUT=2700

# Gaussian-splat training step timeout, in seconds.
GSPLAT_TRAIN_TIMEOUT=1800

# Per-render timeout, in seconds.
RENDER_TIMEOUT=60

# Run the MVCRM multi-view consistency refinement stage (1/true/yes; default true).
MVCRM_ENABLED=true

# --- Security / limits --------------------------------------------------------
# CORS allowlist. "*" (default) suits the public Colab-tunnel demo; in
# production set a comma-separated list of exact origins, e.g.
# CORS_ALLOW_ORIGINS=https://app.example.com,https://www.example.com
CORS_ALLOW_ORIGINS=*

# Reject uploaded images whose DECODED size exceeds this many megapixels
# (decompression-bomb guard). Encoded byte size is separately capped at 20 MB.
MAX_IMAGE_MEGAPIXELS=40

# --- Server -------------------------------------------------------------------
# Port for uvicorn when running app.main directly.
PORT=8000
