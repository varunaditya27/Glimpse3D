# Glimpse3D frontend environment

# Base URL of the backend API.
#
# Leave EMPTY for local development: the app falls back to http://localhost:8000
# (and the Vite dev proxy handles /upload, /generate, /ws, etc.).
#
# For remote / Colab usage, set this to your public tunnel HTTPS URL, e.g.
#   VITE_API_URL=https://your-tunnel.trycloudflare.com
# The app derives the WebSocket URL automatically (https -> wss) and resolves
# backend-relative asset paths (e.g. /outputs/...) against this value.
VITE_API_URL=
